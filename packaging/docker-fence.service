[Unit]
Description=Block Docker containers from opening new connections to listed networks
Documentation=https://github.com/PoschLabs/docker-fence
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker-fence apply
ExecReload=/usr/bin/docker-fence apply
ExecStop=/usr/bin/docker-fence remove

[Install]
WantedBy=multi-user.target
